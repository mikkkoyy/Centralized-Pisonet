# MKY PisoNet Central — environment configuration template
# Copy to .env and fill in values. NEVER commit a real .env file.

# --- Server ---
# Bind host and port for the API/dashboard server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Set to "production" outside localhost; enables stricter cookie settings
ENVIRONMENT=development

# --- Secrets (must be changed before any non-loopback deployment) ---
# Random 256-bit hex string; signs admin session cookies.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-256-bit-hex-value
# Shared enrollment secret for first-boot station registration.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a random secret is generated on first start and must be
# retrieved from the server operator console / logs before stations enroll.
ENROLLMENT_SECRET=

# --- Station policy ---
# Seconds without a heartbeat before a station is marked stale (default 30s)
STATION_HEARTBEAT_TIMEOUT=30

# --- Database ---
# SQLite path, relative to the server working directory
DATABASE_URL=sqlite:///./pisonet.db

# --- HTTPS (documentation only; terminate TLS at a reverse proxy) ---
# For any non-loopback deployment, serve the API and dashboard behind HTTPS.
# Station bearer tokens and admin cookies must never cross plain HTTP.
